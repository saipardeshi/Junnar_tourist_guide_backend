# Copy to `.env` (git-ignored) for local development.
# On Render / any host, set these as environment variables instead.

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/junnar_db?retryWrites=true&w=majority

# HS256 signing key for JWTs - at least 32 characters, random. e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-to-a-long-random-string

# Password for admin@junnar.com. Creates the admin if missing; if set and different from the
# stored password, the admin password is updated on startup. Leave empty to leave it untouched.
ADMIN_PASSWORD=

# OpenWeatherMap API key for the /api/weather proxy (optional). Keep it server-side only -
# do NOT expose it to the frontend as a VITE_* variable.
WEATHER_API_KEY=
